# Postgres role farmenta_backend; must point to database farmenta.
DATABASE_URL=
# Paid RPC URL. This is server-only and must never be prefixed NEXT_PUBLIC_.
RPC_URL=
# Ponder's /status endpoint, normally on the same VPS.
INDEXER_STATUS_URL=
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=
PORT=3000
