# Postgres role farmenta_backend; must point to database farmenta.
DATABASE_URL=
# Paid RPC URL. This is server-only and must never be prefixed NEXT_PUBLIC_.
RPC_URL=
# Ponder's /status endpoint, normally on the same VPS.
INDEXER_STATUS_URL=
# Ponder's GraphQL endpoint. This is the backend's only indexer data source.
INDEXER_GRAPHQL_URL=
# Name of a deployment JSON file in deployments/ (without .json). Endpoints return 503 until set.
FARMENTA_DEPLOYMENT=
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=
# Set to 1 only when the service is behind one trusted reverse proxy.
TRUST_PROXY=0
PORT=3000
